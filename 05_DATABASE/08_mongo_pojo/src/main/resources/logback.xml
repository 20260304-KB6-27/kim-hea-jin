<configuration>
    <!--
    @SLF4J(Simple Logging Facade for Java)
    -->

    <!--appender: 로깅 정보 다루는 방법 (Console: 터미널에 출력)-->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
%n😻경과시간: %-4relative
😎스레드 정보: [%thread]
🍀로그 레벨: %-5level
❤️‍🔥로거 이름: %logger{30}
🎵로그 메시지: %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- 특정 패키지의 로그레벨 설정 -->
    <logger name="org.mongodb.driver.connection" level="INFO" additivity="true"/>

    <!-- 전체 어플리케이션의 로그 설정 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>