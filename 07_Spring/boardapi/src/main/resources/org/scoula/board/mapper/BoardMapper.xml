<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.board.mapper.BoardMapper">
    <insert id="create">
        insert into tbl_board_ex(title, content, writer)
        values (#{title}, #{content}, #{writer})

        <selectKey resultType="Long" keyProperty="no" keyColumn="no" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <!-- 첨부파일 DB에 저장 -->
    <insert id="createAttachment">
        insert into tbl_board_attachment_ex(filename, path, content_type, size, bno)
        values (#{filename}, #{path}, #{contentType}, #{size}, #{bno})  <!-- BoardAttachmentVO.java 필드명 -->
    </insert>

    <select id="getList" resultType="BoardVO">
        select * from tbl_board_ex order by no desc
    </select>

    <select id="get" resultMap="boardMap">
        select b.*, a.no as ano, a.bno, a.filename, a.path,
               a.content_type, a.size, a.reg_date as a_reg_date
        from tbl_board_ex b
                 left outer join tbl_board_attachment_ex a
                                 on b.no = a.bno
        where b.no = #{no}
        order by filename
    </select>

    <!-- 첨부파일 단건 조회 -->
    <select id="getAttachment" resultType="BoardAttachmentVO">
        select * from tbl_board_attachment_ex
        where no = #{no}
    </select>

    <!--
    ResultMap
    - DB 쿼리 결과의 컬럼과 자바 객체의 필드와 매핑
    - 일반적인 경우 (Camel <-> Snake) 변환 정도: Mybatis가 자동 매칭
    - join의 경우: 직접 매핑 필요(ResultMap)
    -->
    <!-- image 한꺼번에 보기 -> resultMap으로 mapping(tbl_board_ex -> BoardVO) 필요 -->
    <resultMap id="boardMap" type="BoardVO">
        <!-- column: tbl_board_ex 컬럼명, property: BoardVO 필드명 -->
        <!-- id: 기본키 매핑 태구 - Mybatis 객체의 동일성 판단, 캐싱/그룹핑할 때 사용 -->
        <id column="no"					property="no"/>
        <result column="title"			property="title"/>
        <result column="content"		property="content"/>
        <result column="writer"			property="writer"/>
        <result column="reg_date"		property="regDate"/>
        <result column="update_date"	property="updateDate"/>

        <!--
        collection: 1 대 N 관계 매핑
        - 조인결과를 한 번에 중첩 객체 형태로 만듦 (BoardVO 안의 BoardAttachmentVO 형태)
        -->
        <collection property="attaches" resultMap="attachmentMap"/>
    </resultMap>

    <!-- BoardVO 내부의 BoardAttachmentVO에 매핑 -->
    <resultMap id="attachmentMap" type="BoardAttachmentVO">
        <id column="ano" 				property="no"/>
        <result column="bno"   			property="bno"/>
        <result column="filename"		property="filename"/>
        <result column="path"			property="path"/>
        <result column="content_type"	property="contentType"/>
        <result column="size"       	property="size"/>
        <result column="a_reg_date" 	property="regDate"/>
    </resultMap>

    <update id="update">
        update tbl_board_ex
        set
            title = #{title},
            content = #{content},
            writer = #{writer},
            update_date = now()
        where no = #{no}
    </update>

    <delete id="delete">
        delete from tbl_board_ex where no = #{no}
    </delete>
</mapper>
