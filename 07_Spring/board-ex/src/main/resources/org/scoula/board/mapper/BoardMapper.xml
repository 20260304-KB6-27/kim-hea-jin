<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.board.mapper.BoardMapper">
    <!-- 생성 -->
    <!-- selectKey와 동일하게 동작 -->
    <insert id="create" parameterType="BoardVO" useGeneratedKeys="true" keyProperty="no">
        insert into tbl_board_ex(title, content, writer)
        values (#{title}, #{content}, #{writer})

        <!-- selectKey: autoincrement로 자동 생성된 pk값 받을 수 있음
             keyProperty: db column 이름, keyColumn: vo field 이름 -->
<!--        <selectKey resultType="long" keyProperty="no" keyColumn="no" order="AFTER">-->
<!--            select last_insert_id()-->
<!--        </selectKey>-->
    </insert>

    <!-- 수정 -->
    <update id="update">
        update tbl_board_ex
        set
            title = #{title},
            content = #{content},
            writer = #{writer},
            update_date = now()
        where no = #{no}
    </update>

    <!-- 삭제 -->
    <delete id="delete">
        delete from tbl_board_ex
        where no = #{no}
    </delete>

    <!-- 전체 조회 -->
    <select id="getList" resultType="org.scoula.board.domain.BoardVO">
        select * from tbl_board_ex
    </select>

    <!-- 단건 조회 -->
    <select id="get" parameterType="long" resultType="BoardVO">
        select * from tbl_board_ex
        where no = #{no}
    </select>

</mapper>