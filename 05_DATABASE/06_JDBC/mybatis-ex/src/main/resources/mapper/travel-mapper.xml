<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
Mapper.xml
- 실행시킬 SQL 구문 작성 (Java 코드와 분리)
- SqlSessionFactory가 mybatis-config에 등록된 mapper를 읽음
-->
<mapper namespace="org.scoula.travel.dao.TravelDao">

    <!--
    namespace: dao 인터페이스의 전체 경로와 일치시키는 것이 관례
    id: java 코드에서 호출할 SQL의 식별자 (dao 인터페이스의 메서드)
    resultType: 반환 타입
    parameterType: Java에서 전달받을 파라미터 클래스
    -->

    <!-- 전체 개수 조회 -->
    <!-- namespace 경로(TravelDao 인터페이스)의 method(getTotalCount)와 연결 -->
    <!-- resultType: TravelDaoImpl.java의 getTotalCount() returnType -->
    <select id="getTotalCount" resultType="int">
        select count(*) from tbl_travel
    </select>

    <!-- 페이지 별 조회 -->
    <select id="getTravels" resultType="TravelVO">
        select * from tbl_travel
        order by district, title
        limit #{start}, #{size}
    </select>

    <!-- 지역 목록 조회 -->
    <select id="getDistricts" resultType="String">
        select distinct district from tbl_travel order by district
    </select>

    <!--
    특정 지역의 여행지 목록 조회
    resultType: 사용자 정의 타입일 때 클래스 경로 작성 (mybatis-config.xml에서 별칭 지정하면 경로 대신 별칭 사용가능)
    TravelDaoImpl.java의 getTravelsByDistrict() parameter(매개변수)로 넘긴 값(district)을 #{district}로 사용가능
    -->
    <select id="getTravelsByDistrict" resultType="TravelVO">
        select * from tbl_travel
        where district = #{district}
        order by title
    </select>

    <!-- 특정 여행지 상세 조회 -->
    <select id="getTravel" resultType="TravelVO">
        select *
        from tbl_travel
        where no = #{no}
    </select>

    <!--
    Insert
    - parameterType: TravelVO 객체의 getter를 이용해 가져옴
                     아래의 SQL 쿼리를 실행하기 위해 Java 코드에서 던져주는 매개변수 Type
    -->
    <insert id="insert" parameterType="TravelVO">
        insert into tbl_travel (district, title, description, address, phone)
        values (#{district}, #{title}, #{description}, #{address}, #{phone})
    </insert>

    <update id="update" parameterType="TravelVO">
        update tbl_travel
        set district = #{district}, title = #{title}, description = #{description}, address = #{address}, phone = #{phone}
        where no = #{no}
    </update>

    <!-- remove: TravelDao.java의 메서드명 -->
    <delete id="remove" parameterType="TravelVO">
        delete from tbl_travel where no = #{no}
    </delete>

</mapper>